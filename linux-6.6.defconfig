# ==========================================================================
# Linux Kernel Config Fragment for STM32MP157F-DK2
# ==========================================================================
#
# This is NOT a complete kernel config. It's a fragment applied ON TOP
# of the multi_v7_defconfig base config. Only options that differ from
# multi_v7 defaults need to be listed here.
#
# The multi_v7_defconfig already enables many ARM SoCs. Our fragment
# ensures STM32MP1-specific drivers and features are included.
#
# To debug kernel config issues:
#   1. Build once (even if it fails)
#   2. cd ~/.nerves/artifacts/.../build/linux-6.6.80/
#   3. make ARCH=arm menuconfig  (browse the config)
#   4. Search for a symbol with '/' in menuconfig
# ==========================================================================

# --- STM32MP1 Core Support ---
CONFIG_ARCH_STM32=y
CONFIG_MACH_STM32MP157=y

# --- Memory ---
CONFIG_ARM_LPAE=y
CONFIG_HIGHMEM=y

# --- Clocks and Power ---
CONFIG_COMMON_CLK_STM32MP157=y
CONFIG_REGULATOR_STM32_PWR=y
CONFIG_REGULATOR_STM32_VREFBUF=y
CONFIG_ARM_STM32_CPUFREQ=y

# --- PMIC (STPMIC1 on I2C4) ---
CONFIG_MFD_STPMIC1=y
CONFIG_REGULATOR_STPMIC1=y

# --- Pin Control ---
CONFIG_PINCTRL_STM32=y
CONFIG_PINCTRL_STM32MP157=y

# --- Serial / UART ---
# ttySTM0 is UART4, wired to ST-LINK virtual COM port
CONFIG_SERIAL_STM32=y
CONFIG_SERIAL_STM32_CONSOLE=y

# --- I2C (used by PMIC, touchscreen, audio codec) ---
CONFIG_I2C_STM32F7=y

# --- SPI ---
CONFIG_SPI_STM32=y

# --- Ethernet (Synopsys DesignWare MAC + Realtek PHY) ---
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_STM32=y
CONFIG_PHY_REALTEK=y

# --- USB ---
CONFIG_USB_DWC2=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=y

# --- MMC/SD (boot medium) ---
CONFIG_MMC_STM32_SDMMC=y

# --- DMA ---
CONFIG_STM32_DMA=y
CONFIG_STM32_DMAMUX=y
CONFIG_STM32_MDMA=y

# --- Remoteproc (Cortex-M4 coprocessor) ---
# Critical for Phase 2 — enables loading firmware onto the M4
# and communicating via RPMsg
CONFIG_REMOTEPROC=y
CONFIG_STM32_RPROC=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_VIRTIO=y

# --- Watchdog ---
CONFIG_IWDG_STM32=y

# --- RTC ---
CONFIG_RTC_DRV_STM32=y

# --- Hardware Random Number Generator ---
CONFIG_HW_RANDOM_STM32=y

# --- Crypto (F variant has hardware acceleration) ---
CONFIG_CRYPTO_DEV_STM32_HASH=y
CONFIG_CRYPTO_DEV_STM32_CRC=y

# --- GPU/Display (for Phase 4) ---
CONFIG_DRM=y
CONFIG_DRM_STM=y
CONFIG_DRM_STM_DSI=y
CONFIG_DRM_PANEL_ORISETECH_OTM8009A=y

# --- Touch (for Phase 4) ---
CONFIG_TOUCHSCREEN_GOODIX=y

# --- WiFi/BLE (Murata/CYW43455 combo module) ---
# Built as modules so they can be loaded on demand
CONFIG_BRCMFMAC=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y

# --- Nerves Requirements ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_F2FS_FS=y

# --- Nerves Networking ---
# VintageNet uses Linux policy routing (ip rule) to manage multiple interfaces.
# Without these, VintageNet.RouteManager crashes with "Rule family not supported"
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
