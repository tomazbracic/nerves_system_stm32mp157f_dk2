# ==========================================================================
# Nerves System Buildroot Configuration for STM32MP157F-DK2
# ==========================================================================
#
# This file tells Buildroot what to build and how. It's the central
# configuration for the entire system — toolchain, kernel, bootloaders,
# packages, and root filesystem.
#
# Based on upstream Buildroot's stm32mp157c_dk2_defconfig, adapted for
# Nerves conventions. Key changes from upstream:
#   - Bootlin external toolchain (GCC 14.3) — Nerves GCC 13.2 produces
#     broken U-Boot binaries on STM32MP1
#   - Nerves skeleton, overlay, and BusyBox config
#   - SquashFS rootfs instead of ext4
#   - Nerves-specific packages (nbtty, nerves_config)
#   - Uses C variant device tree (F variant DTS doesn't exist in mainline)
# ==========================================================================

# --------------------------------------------------------------------------
# Architecture
# --------------------------------------------------------------------------
# The STM32MP157 has dual Cortex-A7 cores (ARMv7-A architecture)
# with NEON SIMD and VFPv4 floating point.
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y

# --------------------------------------------------------------------------
# Toolchain
# --------------------------------------------------------------------------
# We use Bootlin's pre-built external toolchain instead of the Nerves
# crosstool-ng toolchain. The Nerves toolchain (GCC 13.2,
# armv7-nerves-linux-gnueabihf) produces U-Boot binaries that crash
# silently on STM32MP1. The Bootlin toolchain (GCC 14.3,
# arm-linux-gnueabihf) works correctly — confirmed by building vanilla
# Buildroot stm32mp157c_dk2_defconfig.
#
# This matches what upstream Buildroot uses for this board.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV7_EABIHF_GLIBC_STABLE=y

# --------------------------------------------------------------------------
# System Configuration
# --------------------------------------------------------------------------
# Nerves doesn't use a traditional init system (no systemd, no sysvinit).
# erlinit (the Nerves init) is the only process manager — it starts the
# BEAM VM and restarts it if it crashes.
BR2_TARGET_GENERIC_HOSTNAME="nerves"
BR2_TARGET_GENERIC_ISSUE="Nerves STM32MP157F-DK2"
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y

# --------------------------------------------------------------------------
# Nerves Skeleton and Overlay
# --------------------------------------------------------------------------
# The skeleton is the base directory structure of the root filesystem.
# Nerves uses its own minimal skeleton instead of Buildroot's default.
#
# The overlay copies additional files on top of the built rootfs.
# We have two overlays:
#   1. nerves-common overlay (from nerves_system_br) — shared across all systems
#   2. Our custom overlay — board-specific files (erlinit.config, fw_env.config)
#
# ${BR2_EXTERNAL_NERVES_PATH} points to nerves_system_br's board/ directory
# ${NERVES_DEFCONFIG_DIR} points to THIS directory (phase1_nerves_system/)
BR2_ROOTFS_SKELETON_CUSTOM=y
BR2_ROOTFS_SKELETON_CUSTOM_PATH="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/skeleton"
BR2_ROOTFS_OVERLAY="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/rootfs_overlay ${NERVES_DEFCONFIG_DIR}/rootfs_overlay"

# --------------------------------------------------------------------------
# Post-Build and Post-Image Scripts
# --------------------------------------------------------------------------
# post-build.sh runs after Buildroot assembles the rootfs directory.
# post-createfs.sh runs after the rootfs image is created — it calls
# fwup to package everything into the final .fw firmware file.
BR2_ROOTFS_POST_BUILD_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-build.sh ${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/post-build.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="${NERVES_DEFCONFIG_DIR}"
BR2_ROOTFS_POST_IMAGE_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-createfs.sh"

# --------------------------------------------------------------------------
# Linux Kernel
# --------------------------------------------------------------------------
# We use kernel 6.6 (LTS) with the multi_v7 defconfig as a base,
# plus our own config fragment that enables STM32MP1-specific drivers.
#
# BR2_LINUX_KERNEL_INTREE_DTS_NAME tells Buildroot which device tree
# to compile. We use the C variant because the F variant DTS does not
# exist in mainline Linux (verified up to v6.14). The C and F variants
# are software-compatible.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.80"
BR2_LINUX_KERNEL_DEFCONFIG="multi_v7"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/linux-6.6.defconfig"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="st/stm32mp157c-dk2"
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# --------------------------------------------------------------------------
# TF-A (Trusted Firmware-A) — First-Stage Bootloader
# --------------------------------------------------------------------------
# TF-A is the very first code that runs after the ROM bootloader.
# It initializes DDR, the PMIC, and clocks, then loads the FIP binary.
#
# The FIP (Firmware Image Package) bundles the secure monitor (sp_min)
# and U-Boot into a single authenticated package.
#
# DTB_FILE_NAME must match the device tree name — stm32mp157c-dk2.dtb
# (not F, because the F variant DTS doesn't exist).
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_LATEST_LTS_2_10_VERSION=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="stm32mp1"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_FIP=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_BL31=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_UBOOT_AS_BL33=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_UBOOT_BL33_IMAGE="u-boot-nodtb.bin"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_ADDITIONAL_VARIABLES="STM32MP_SDMMC=1 AARCH32_SP=sp_min DTB_FILE_NAME=stm32mp157c-dk2.dtb E=0 BL33_CFG=$(BINARIES_DIR)/u-boot.dtb"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_IMAGES="fip.bin *.stm32"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_NEEDS_DTC=y

# --------------------------------------------------------------------------
# U-Boot — Second-Stage Bootloader
# --------------------------------------------------------------------------
# U-Boot loads the Linux kernel and device tree from the rootfs partition.
# We use the "trusted" defconfig which works with TF-A (not the "basic"
# defconfig which uses U-Boot's own SPL).
#
# DEVICE_TREE must match: stm32mp157c-dk2 (same C variant reasoning).
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2025.10"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="stm32mp15_trusted"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/uboot/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
# BR2_TARGET_UBOOT_FORMAT_BIN is not set
BR2_TARGET_UBOOT_FORMAT_DTB=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-nodtb.bin"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="DEVICE_TREE=st/stm32mp157c-dk2"

# --------------------------------------------------------------------------
# Root Filesystem
# --------------------------------------------------------------------------
# Nerves uses SquashFS (read-only, compressed) for the rootfs.
# This enables A/B firmware updates — you can't accidentally corrupt
# a read-only filesystem. LZ4 compression is fast to decompress.
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y

# --------------------------------------------------------------------------
# BusyBox
# --------------------------------------------------------------------------
# Nerves uses a minimal BusyBox configuration shared across all systems.
BR2_PACKAGE_BUSYBOX_CONFIG="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/busybox.config"

# --------------------------------------------------------------------------
# Filesystem Tools
# --------------------------------------------------------------------------
# f2fs-tools: Flash-Friendly File System utilities (mkfs.f2fs)
# Required so nerves_runtime can auto-format the app data partition on first boot.
# Without this, the app partition stays unformatted and /root is read-only.
BR2_PACKAGE_F2FS_TOOLS=y

# --------------------------------------------------------------------------
# Nerves Packages
# --------------------------------------------------------------------------
# nbtty: Nerves serial console handler
# nerves_config: Configuration management
BR2_PACKAGE_NBTTY=y
BR2_PACKAGE_NERVES_CONFIG=y
# Acknowledge that rng-tools is no longer a forced dependency in Nerves.
# Linux kernels >= 5.6 have built-in entropy sources (RANDOM_TRUST_CPU),
# so the userspace rng-tools daemon is typically unnecessary.
BR2_PACKAGE_NERVES_CONFIG_ACCEPT_RNG_NOTICE=y

# --------------------------------------------------------------------------
# Erlang/OTP
# --------------------------------------------------------------------------
BR2_PACKAGE_ERLANG=y
BR2_PACKAGE_ERLANG_SMP=y

# --------------------------------------------------------------------------
# Networking
# --------------------------------------------------------------------------
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_DROPBEAR=y
# libmnl is required by nerves_uevent (part of nerves_pack) for
# netlink socket communication with the kernel.
BR2_PACKAGE_LIBMNL=y
# libnl is required by vintage_net_wifi for WiFi AP scanning
# via generic netlink sockets (libnl-genl-3.0).
BR2_PACKAGE_LIBNL=y

# --------------------------------------------------------------------------
# Graphics — Scenic UI support
# --------------------------------------------------------------------------
# scenic_driver_local v0.11+ uses cairo-fb for software rendering on the
# framebuffer. No GPU/mesa/EGL needed — cairo renders in software which is
# plenty fast for the DK2's 480x800 display on dual Cortex-A7.
# The kernel already has DRM_STM, DRM_STM_DSI, the OTM8009A panel driver,
# DRM_FBDEV_EMULATION (/dev/fb0), and TOUCHSCREEN_GOODIX + INPUT_EVDEV
# enabled via multi_v7_defconfig defaults.
BR2_PACKAGE_CAIRO=y
BR2_PACKAGE_CAIRO_PNG=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_PIXMAN=y

# --------------------------------------------------------------------------
# Firmware Tools
# --------------------------------------------------------------------------
BR2_PACKAGE_HOST_FWUP=y
# U-Boot host tools — provides mkenvimage for compiling the U-Boot
# environment text file (uboot.env) into a binary (uboot-env.bin).
BR2_PACKAGE_HOST_UBOOT_TOOLS=y

# --------------------------------------------------------------------------
# Nerves System Identification
# --------------------------------------------------------------------------
# These tell the Nerves build system what this system is called and
# which additional files to include in the output.
BR2_NERVES_SYSTEM_NAME="nerves_system_stm32mp157f_dk2"
BR2_NERVES_ADDITIONAL_IMAGE_FILES="${NERVES_DEFCONFIG_DIR}/fwup.conf ${NERVES_DEFCONFIG_DIR}/fwup-revert.conf"
