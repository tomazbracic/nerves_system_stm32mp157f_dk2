# erlinit configuration for STM32MP157F-DK2
#
# erlinit is Nerves' init system (PID 1). It replaces systemd/sysvinit.
# Its only job: start the BEAM VM and restart it if it crashes.
#
# Modeled after nerves_system_rpi5's erlinit.config.

# Serial console on UART4 (ST-LINK virtual COM port)
# This is where IEx appears when you connect via picocom
-c ttySTM0

# If more than one tty are available, warn if looking at the wrong one
--warn-unused-tty

# Use nbtty to improve terminal handling on serial ports
-s "/usr/bin/nbtty"

# Mount the application data partition (must match fwup.conf partition layout)
# Partition 5 (app) = /dev/mmcblk0p6, formatted as f2fs.
# If this mount fails on first boot, nerves_runtime will auto-format it.
-m /dev/mmcblk0p6:/root:f2fs::

# cgroup mounts (needed for process resource management)
-m tmpfs:/sys/fs/cgroup:tmpfs:nodev,noexec,nosuid:mode=755,size=1024k
-m cpu:/sys/fs/cgroup/cpu:cgroup:nodev,noexec,nosuid:cpu

# Enable UTF-8 locale and custom inet configuration
-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc

# Enable crash dumps to the writable app partition
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# Erlang release search path
-r /srv/erlang

# Hostname — static for now (STM32MP1 doesn't have boardid like RPi)
--hostname nerves-stm32mp1

# If using shoehorn, boot it first. Falls back to main release if unavailable.
--boot shoehorn

# Graceful shutdown timeout (ms)
--graceful-shutdown-timeout 10000

# Uncomment for development debugging (keeps console accessible after crash)
# In production, erlinit should auto-restart the BEAM.
#--hang-on-exit
